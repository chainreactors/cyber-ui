{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chainreactors/cyber-ui/packages/agent-protocol/schema/events/tool.call.schema.json",
  "title": "ToolCallData",
  "type": "object",
  "required": ["tool_call_id", "tool_name", "args"],
  "properties": {
    "tool_call_id": { "type": "string", "minLength": 1 },
    "tool_name": { "type": "string", "minLength": 1 },
    "args": { "goJSONSchema": { "type": "any" } },
    "work_dir": { "type": "string", "goJSONSchema": { "pointer": false } }
  },
  "additionalProperties": false
}
