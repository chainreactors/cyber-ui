    "agent_type": { "type": "string", "goJSONSchema": { "pointer": false } },
    "run_mode": { "type": "string", "enum": ["foreground", "background"], "goJSONSchema": { "pointer": false } },
    "context_mode": { "type": "string", "enum": ["fresh", "fork"], "goJSONSchema": { "pointer": false } }
  },
  "additionalProperties": false
}
