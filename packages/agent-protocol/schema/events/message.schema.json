{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chainreactors/cyber-ui/packages/agent-protocol/schema/events/message.schema.json",
  "title": "MessageData",
  "type": "object",
  "required": ["message_id", "role", "parts"],
  "properties": {
    "message_id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "parts": {
      "type": "array",
      "items": { "$ref": "#/$defs/message_part" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "image_source": {
      "title": "ImageSource",
      "type": "object",
      "properties": {
        "base64": { "type": "string", "goJSONSchema": { "pointer": false } },
        "media_type": { "type": "string", "goJSONSchema": { "pointer": false } },
        "path": { "type": "string", "goJSONSchema": { "pointer": false } }
      },
      "additionalProperties": false
    },
    "message_part": {
      "title": "MessagePart",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "goJSONSchema": { "pointer": false } },
        "image": { "$ref": "#/$defs/image_source" }
      },
      "additionalProperties": false
    }
  }
}
