{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chainreactors/cyber-ui/packages/agent-protocol/schema/ext/aop.schema.json",
  "$defs": {
    "budget_warning": {
      "title": "BudgetWarning",
      "type": "object",
      "required": ["context_tokens", "token_budget"],
      "properties": {
        "context_tokens": { "type": "integer", "minimum": 0 },
        "token_budget": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "llm_request": {
      "title": "LLMRequest",
      "type": "object",
      "required": ["model", "messages", "max_tokens", "stream"],
      "properties": {
        "model": { "type": "string" },
        "messages": { "type": "integer", "minimum": 0 },
        "max_tokens": { "type": "integer", "minimum": 0 },
        "stream": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "message_meta": {
      "title": "MessageMeta",
      "type": "object",
      "properties": {
        "agent_id": { "type": "string", "goJSONSchema": { "pointer": false } },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
