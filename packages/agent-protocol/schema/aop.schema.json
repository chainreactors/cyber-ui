{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chainreactors/cyber-ui/packages/agent-protocol/schema/aop.schema.json",
  "title": "Agent Output Protocol Event",
  "type": "object",
  "required": ["type", "ts", "session_id", "agent", "data"],
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "session_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "agent": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "data": { "type": "object" },
    "ext": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "session.start" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "events/session.start.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "session.end" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "events/session.end.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "message" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "events/message.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "message.delta" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "events/message.delta.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "tool.call" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "events/tool.call.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "tool.result" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "events/tool.result.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "usage" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "events/usage.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "turn.start" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "events/turn.start.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "turn.end" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "events/turn.end.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "error" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "events/error.schema.json" } } }
    },
    {
      "if": { "properties": { "type": { "const": "status" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "events/status.schema.json" } } }
    }
  ]
}
