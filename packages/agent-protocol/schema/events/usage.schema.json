{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chainreactors/cyber-ui/packages/agent-protocol/schema/events/usage.schema.json",
  "title": "UsageData",
  "type": "object",
  "required": ["input_tokens", "output_tokens", "total_tokens"],
  "properties": {
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "cache_read_tokens": { "type": "integer", "minimum": 0, "goJSONSchema": { "pointer": false } },
    "cache_write_tokens": { "type": "integer", "minimum": 0, "goJSONSchema": { "pointer": false } },
    "model": { "type": "string", "goJSONSchema": { "pointer": false } }
  },
  "additionalProperties": false
}
